```dart
import 'package:firebase_auth/firebase_auth.dart';

class AuthRepository {
  Stream<User?> get changes => FirebaseAuth.instance.authStateChanges();
  Future<void> signOut() => FirebaseAuth.instance.signOut();
}
```

